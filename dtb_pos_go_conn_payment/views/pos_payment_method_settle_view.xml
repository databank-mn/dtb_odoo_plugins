<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_go_conn" model="ir.ui.view">
        <field name="name">pos.payment.method.form.go.conn</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='Payment methods']" position="inside">
                <field name="go_conn_settle_on_close" invisible="use_payment_terminal != 'dtb_go_conn'"/>
            </xpath>
        </field>
    </record>
</odoo>
