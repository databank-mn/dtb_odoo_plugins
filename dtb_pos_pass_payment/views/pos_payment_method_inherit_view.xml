<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_pass" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pass</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="is_pass_test_mode" 
                    groups="base.group_no_one"
                    attrs="{'invisible':[('use_payment_terminal','!=','pass')]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_form_inherit_pass" model="ir.ui.view">
        <field name="name">view.pos.payment.form.inherit.pass</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="after">
                <label for="is_pass" string="Is pass?"/>
                <field name="is_pass" readonly="1"/>
                <group col="4" string="PASS payment info" attrs="{'invisible':[('is_pass','=',False)]}">
                    <field name="pass_status" readonly="1"/>
                    <field name="pass_db_ref_no" readonly="1"/>

                    <field name="pass_resp_code" readonly="1"/>
                    <field name="pass_terminal_id" readonly="1"/>

                    <field name="pass_approval_code" readonly="1"/>
                    <field name="pass_payment_request_id" readonly="1"/>

                    <field name="pass_rrn" readonly="1"/>
                    <field name="pass_textresponse" readonly="1" colspan="4"
                        groups="base.group_no_one"/>
                </group>
           </xpath>
        </field>
    </record>

</odoo>
