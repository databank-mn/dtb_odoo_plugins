<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_session_dtb_inherit_view" model="ir.ui.view">
        <field name="name">POS Session DTB inherit</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stop_at']" position="after">
                <field name="dtb_sale_count"/>
                <field name="dtb_sale_total"/>
                <field name="dtb_void_count"/>
                <field name="dtb_void_total"/>
                <field name="dtb_description"/>
            </xpath>
        </field>
    </record>

</odoo>
