<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_inherit" model="ir.ui.view">
        <field name="name">view.pos.payment.form.inherit</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="after">
                <label for="is_dtb_card" string="Is databank?"/>
                <field name="is_dtb_card" readonly="1"/>
                <group col="4" string="DTB payment info" attrs="{'invisible':[('is_dtb_card','=',False)]}">
                    <field name="dtb_status" readonly="1"/>
                    <field name="dtb_auth_code" readonly="1"/>

                    <field name="dtb_terminal_id" readonly="1"/>
                    <field name="dtb_merchant_id" readonly="1"/>

                    <field name="dtb_amount" readonly="1"/>
                    <field name="dtb_card_no" readonly="1"/>

                    <field name="dtb_db_ref_no" readonly="1"/>
                    <field name="dtb_ref_no" readonly="1"/>

                    <field name="dtb_textresponse" readonly="1" colspan="4"
                        groups="base.group_no_one"/>
                </group>
           </xpath>
        </field>
    </record>
</odoo>
